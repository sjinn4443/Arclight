# Environment variables for the Arclight app

# Server
PORT=3000
NODE_ENV=development
HOST=127.0.0.1
# Keep disabled for direct/local deployments. Railway currently uses one proxy hop.
TRUST_PROXY=0

# Optional: reports / admin auth
# Required at runtime; generate an independent random value of at least 24 characters.
# DASHBOARD_PASSWORD=<generate-a-random-dashboard-password>
# ADMIN_ALLOWED_IPS=203.0.113.10,198.51.100.8
# REPORTS_ALLOW_LOCAL_DELETE=false
# REPORTS_ALLOW_DELETE=false
# REPORTS_AUDIT_RETENTION_DAYS=365

# Optional: emergency controls
# EMERGENCY_MODE=off
# Supported modes: off | readonly | emergency | lockdown
# EMERGENCY_MESSAGE=We\u2019re currently performing maintenance. Some features may be unavailable.

# Optional: runtime storage
# Leave DB vars commented out unless you really want Postgres-backed storage.
# DATABASE_URL=postgres://user:password@host:5432/database
# REPORTS_READ_DATABASE_URL=postgres://readonly_user:password@host:5432/database
# REPORTS_ADMIN_DATABASE_URL=postgres://admin_user:password@host:5432/database
# Production without a DB uses no-op storage by default. Only enable this
# intentionally, and only with ENCRYPTION_SECRET set.
# ENABLE_NDJSON_STORAGE=false

# Optional: telemetry write allowlist
# TELEMETRY_ALLOWED_HOSTS=app.example.com,www.example.com
# Required at runtime; generate an independent random value of at least 32 characters.
# TELEMETRY_TOKEN_SECRET=<generate-a-random-telemetry-secret>
# TELEMETRY_RETENTION_DAYS=90

# Optional: runtime monitoring origins for CSP allowlisting
# ARCLIGHT_SENTRY_DSN=https://public@example.ingest.sentry.io/123456
# ARCLIGHT_SENTRY_BUNDLE_URL=https://browser.sentry-cdn.com/7.120.3/bundle.tracing.replay.min.js

# Optional: secrets
# ENCRYPTION_SECRET=replace-with-a-long-random-secret
# IPINFO_TOKEN=replace-with-your-server-side-token
# ENABLE_IP_LOCATION_LOOKUP=true

# DB TLS
# DB_SSL=disable
# DB_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# Railway internal Postgres hosts (*.railway.internal) are handled automatically.
# DB_SSL_ALLOW_SELF_SIGNED=false
