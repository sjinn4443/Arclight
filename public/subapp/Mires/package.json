{
  "name": "arclight-mires",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild app.js --bundle --minify --format=iife --target=es2018 --outfile=app.bundle.js --log-level=warning",
    "test": "node --test --experimental-test-isolation=none tests/contracts.test.mjs tests/logic.test.mjs",
    "test:bundle": "node tools/check-bundle.mjs",
    "check": "npm test && npm run test:bundle",
    "test:browser": "node tests/browser-smoke.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.5",
    "playwright-core": "1.55.0"
  }
}
