        </mxCell>
        <mxCell id="YOUNGER_SPHERE_STEP" value="&lt;b&gt;Use the bounded younger half-change seed&lt;/b&gt;&lt;br&gt;Step = round(gap × 0.5 × q × clamp(1 + m, 0, 1.2))&lt;br&gt;Cap 0.5 D; either |S| ≥6 D → 0.25 D&lt;br&gt;Move towards measured S and round to 0.25 D" ruleIds="W10_YOUNGER_SPHERE" style="rounded=0;fillColor=#e3f0fc;strokeColor=#47749c;strokeWidth=2.5;whiteSpace=wrap;html=1;fontSize=18;fontFamily=Arial;fontColor=#172635;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
