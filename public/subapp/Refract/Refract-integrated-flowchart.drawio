<mxfile host="app.diagrams.net" modified="2026-09-30T00:00:00.000Z" type="device">
  <diagram id="refract-weighted-integrated" name="Integrated weighted prescribing">
    <mxGraphModel dx="4890" dy="10950" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="4890" pageHeight="10950" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="LEGEND" value="&lt;b&gt;REFRACT — INTEGRATED WEIGHTED RULES&lt;/b&gt;&lt;br&gt;30 September 2026 · editable working chart · default settings&lt;br&gt;Amber: decision · blue: action · red: review · green: result&lt;br&gt;S: sphere · C: cylinder · Rx: prescription · q: confidence&lt;br&gt;All clamps below are 0–1 unless shown otherwise.&lt;br&gt;Provisional engineering policy; clinical sign-off pending." ruleIds="" style="text;align=left;fillColor=none;strokeColor=none;strokeWidth=2.5;whiteSpace=wrap;html=1;fontSize=18;fontFamily=Arial;fontColor=#172635;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="300" y="0" width="950" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="VISIBLE_WEIGHTS" value="&lt;b&gt;WEIGHTINGS — CURRENT VALUES&lt;/b&gt;&lt;br&gt;Dimensionless unless marked D. Clamps in this panel limit to 0–1.&lt;br&gt;&lt;br&gt;&lt;b&gt;Patient adjustment m: sum the selected effects&lt;/b&gt;&lt;br&gt;Calm / easy-going: +0.04&lt;br&gt;New to this practice (repeat = 0): −0.05&lt;br&gt;Returning (repeat = 1): +0.025&lt;br&gt;Poor health / frailty: −0.05&lt;br&gt;Age 65 or over: −0.05&lt;br&gt;Unknown / unselected: 0. New and returning are alternatives.&lt;br&gt;&lt;br&gt;&lt;b&gt;Precise / demanding: resistance when selected, otherwise 0&lt;/b&gt;&lt;br&gt;Subtract 2.00 from component signal t.&lt;br&gt;Subtract 0.20 from larger-change pull p.&lt;br&gt;&lt;br&gt;&lt;b&gt;Measurement confidence q&lt;/b&gt;&lt;br&gt;Recorded quality Q: q = clamp((Q − 5) / 3)&lt;br&gt;No valid Q: accurate → 1; inaccurate → 0; unknown → 0.25&lt;br&gt;&lt;br&gt;&lt;b&gt;How the weights combine&lt;/b&gt;&lt;br&gt;Component signal: t = 1.50q + m − precise resistance&lt;br&gt;Larger-sphere branch: p = clamp(0.40 + 0.50q + m − precise resistance)&lt;br&gt;Then larger-change pull = clamp((p + 0.20) × q)&lt;br&gt;Larger-sphere weighting applies only at a sphere gap ≥1.25 D.&lt;br&gt;&lt;br&gt;&lt;b&gt;Reading add: frailty +0.25 D only on the age-derived add.&lt;/b&gt;&lt;br&gt;Guards and step caps still take priority: follow the arrows below.&lt;br&gt;Provisional authored settings — not clinically validated." ruleIds="" style="text;align=left;fillColor=#f4f8fc;strokeColor=#47749c;strokeWidth=2.5;whiteSpace=wrap;html=1;fontSize=22;fontFamily=Arial;fontColor=#172635;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="300" y="260" width="950" height="900" as="geometry"/>
        </mxCell>
        <mxCell id="START" value="&lt;b&gt;Patient assessment&lt;/b&gt;" ruleIds="" style="rounded=1;arcSize=50;fillColor=#e8edf2;strokeColor=#526171;strokeWidth=2.5;whiteSpace=wrap;html=1;fontSize=18;fontFamily=Arial;fontColor=#172635;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1550" y="30" width="500" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="INPUT" value="&lt;b&gt;Enter current and measured Rx for both eyes&lt;/b&gt;&lt;br&gt;Age · per-eye quality or accuracy · good current VA&lt;br&gt;Precise · calm · health · new / returning / unknown · current/measured add" ruleIds="" style="rounded=0;fillColor=#e3f0fc;strokeColor=#47749c;strokeWidth=2.5;whiteSpace=wrap;html=1;fontSize=18;fontFamily=Arial;fontColor=#172635;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1400" y="170" width="800" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="VALID" value="&lt;b&gt;Where sphere is recorded:&lt;/b&gt;&lt;br&gt;non-zero C has a valid&lt;br&gt;axis 0–180°?" ruleIds="W0_VALIDATE" style="rhombus;fillColor=#fff1c9;strokeColor=#9c7a29;strokeWidth=2.5;whiteSpace=wrap;html=1;fontSize=18;fontFamily=Arial;fontColor=#172635;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1515" y="380" width="570" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="INVALID" value="&lt;b&gt;Complete or correct entries&lt;/b&gt;&lt;br&gt;No proposed Rx until axis is valid" ruleIds="W0_VALIDATE" style="rounded=0;fillColor=#fce3e3;strokeColor=#b45757;strokeWidth=2.5;whiteSpace=wrap;html=1;fontSize=18;fontFamily=Arial;fontColor=#172635;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="2350" y="415" width="760" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="NORMALISE" value="&lt;b&gt;Convert recorded Rx to minus cylinder&lt;/b&gt;&lt;br&gt;Missing sphere is unassessed, not plano&lt;br&gt;Check discrepancy before Simple-mode projection" ruleIds="W0_VALIDATE" style="rounded=0;fillColor=#e3f0fc;strokeColor=#47749c;strokeWidth=2.5;whiteSpace=wrap;html=1;fontSize=18;fontFamily=Arial;fontColor=#172635;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1400" y="630" width="800" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="SIMPLE" value="&lt;b&gt;Simple mode&lt;/b&gt;&lt;br&gt;explicitly selected?" ruleIds="W2_SIMPLE" style="rhombus;fillColor=#fff1c9;strokeColor=#9c7a29;strokeWidth=2.5;whiteSpace=wrap;html=1;fontSize=18;fontFamily=Arial;fontColor=#172635;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1570" y="830" width="460" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="SPHERICAL" value="&lt;b&gt;Use spherical equivalent: S + C/2&lt;/b&gt;&lt;br&gt;Round to 0.25 D; leave output C and axis blank" ruleIds="W2_SIMPLE" style="rounded=0;fillColor=#e3f0fc;strokeColor=#47749c;strokeWidth=2.5;whiteSpace=wrap;html=1;fontSize=18;fontFamily=Arial;fontColor=#172635;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="2350" y="855" width="760" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="PREPARED" value="&lt;b&gt;Use the selected representation&lt;/b&gt;&lt;br&gt;Advanced: S / C / axis; Simple: spherical equivalent" ruleIds="W2_SIMPLE" style="rounded=0;fillColor=#e3f0fc;strokeColor=#47749c;strokeWidth=2.5;whiteSpace=wrap;html=1;fontSize=18;fontFamily=Arial;fontColor=#172635;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1400" y="1060" width="800" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="DISCREPANCY" value="&lt;b&gt;Before projection:&lt;/b&gt;&lt;br&gt;large discrepancy in either eye?" ruleIds="W1_LARGE_DISCREPANCY" style="rhombus;fillColor=#fff1c9;strokeColor=#9c7a29;strokeWidth=2.5;whiteSpace=wrap;html=1;fontSize=18;fontFamily=Arial;fontColor=#172635;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1570" y="1240" width="460" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="PAIR_HOLD" value="&lt;b&gt;Keep both current distance prescriptions&lt;/b&gt;&lt;br&gt;ΔS ≥3 D or ΔC ≥2 D&lt;br&gt;or Δaxis ≥60° with both |C| ≥1 D&lt;br&gt;Verify measurements; preserve Simple-mode representation" ruleIds="W1_LARGE_DISCREPANCY" style="rounded=0;fillColor=#fce3e3;strokeColor=#b45757;strokeWidth=2.5;whiteSpace=wrap;html=1;fontSize=18;fontFamily=Arial;fontColor=#172635;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="480" y="1252.5" width="820" height="155" as="geometry"/>
        </mxCell>
        <mxCell id="CONFIDENCE" value="&lt;b&gt;Calculate each eye’s confidence q&lt;/b&gt;&lt;br&gt;Valid Q (0–10): q = clamp((Q − 5) / 3)&lt;br&gt;Otherwise accuracy true → 1; false → 0; unknown → 0.25&lt;br&gt;Apply the same patient context to each eye separately" ruleIds="W7_WEIGHTED_COMPONENTS" style="rounded=0;fillColor=#e3f0fc;strokeColor=#47749c;strokeWidth=2.5;whiteSpace=wrap;html=1;fontSize=18;fontFamily=Arial;fontColor=#172635;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1400" y="1490" width="800" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="OBJECTIVE" value="&lt;b&gt;Measured sphere&lt;/b&gt;&lt;br&gt;recorded for this eye?" ruleIds="W3_NO_OBJECTIVE" style="rhombus;fillColor=#fff1c9;strokeColor=#9c7a29;strokeWidth=2.5;whiteSpace=wrap;html=1;fontSize=18;fontFamily=Arial;fontColor=#172635;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1570" y="1720" width="460" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="RETAIN_RECORDED" value="&lt;b&gt;Keep current Rx for this eye&lt;/b&gt;&lt;br&gt;Neither sphere recorded → leave eye blank" ruleIds="W3_NO_OBJECTIVE" style="rounded=0;fillColor=#e3f0fc;strokeColor=#47749c;strokeWidth=2.5;whiteSpace=wrap;html=1;fontSize=18;fontFamily=Arial;fontColor=#172635;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="480" y="1745" width="760" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="CURRENT" value="&lt;b&gt;Current sphere recorded&lt;/b&gt;&lt;br&gt;for this eye?" ruleIds="W4_NO_ANCHOR" style="rhombus;fillColor=#fff1c9;strokeColor=#9c7a29;strokeWidth=2.5;whiteSpace=wrap;html=1;fontSize=18;fontFamily=Arial;fontColor=#172635;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1570" y="1950" width="460" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="NO_ANCHOR" value="&lt;b&gt;No recorded anchor: provisional seed&lt;/b&gt;&lt;br&gt;Precise S: round(S − sign(S) × min(|S|, 0.25 D)) to 0.25 D&lt;br&gt;Precise C: reduce |C| by 0.25 D, stop at zero, round 0.25 D&lt;br&gt;Missing or reduced |C| &amp;lt;0.25 D → leave C/axis blank&lt;br&gt;Otherwise round measured axis: 5° below 1.75 D, 1° otherwise&lt;br&gt;Not precise: measured S/C rounded to 0.25 D; measured axis unchanged&lt;br&gt;Current sphere absent clears current C/axis; no corroborated-C exception&lt;br&gt;Missing recorded Rx does not prove a first-ever pair" ruleIds="W4_NO_ANCHOR" style="rounded=0;fillColor=#fce3e3;strokeColor=#b45757;strokeWidth=2.5;whiteSpace=wrap;html=1;fontSize=18;fontFamily=Arial;fontColor=#172635;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="2350" y="1917.5" width="1120" height="225" as="geometry"/>
        </mxCell>
        <mxCell id="GOOD_VA" value="&lt;b&gt;Good current VA&lt;/b&gt;&lt;br&gt;explicitly selected?" ruleIds="W5_GOOD_VA" style="rhombus;fillColor=#fff1c9;strokeColor=#9c7a29;strokeWidth=2.5;whiteSpace=wrap;html=1;fontSize=18;fontFamily=Arial;fontColor=#172635;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1570" y="2180" width="460" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="VA_HOLD" value="&lt;b&gt;Keep current Rx for this eye&lt;/b&gt;&lt;br&gt;Good VA must be explicitly selected" ruleIds="W5_GOOD_VA" style="rounded=0;fillColor=#e3f0fc;strokeColor=#47749c;strokeWidth=2.5;whiteSpace=wrap;html=1;fontSize=18;fontFamily=Arial;fontColor=#172635;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="480" y="2205" width="820" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="LOW_Q" value="&lt;b&gt;Confidence q = 0?&lt;/b&gt;&lt;br&gt;(quality Q ≤5 or accuracy false)" ruleIds="W6_LOW_CONFIDENCE" style="rhombus;fillColor=#fff1c9;strokeColor=#9c7a29;strokeWidth=2.5;whiteSpace=wrap;html=1;fontSize=18;fontFamily=Arial;fontColor=#172635;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1570" y="2410" width="460" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="Q_HOLD" value="&lt;b&gt;Keep current Rx for this eye&lt;/b&gt;&lt;br&gt;Low confidence: no measured change" ruleIds="W6_LOW_CONFIDENCE" style="rounded=0;fillColor=#fce3e3;strokeColor=#b45757;strokeWidth=2.5;whiteSpace=wrap;html=1;fontSize=18;fontFamily=Arial;fontColor=#172635;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="480" y="2445" width="820" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="WEIGHTS" value="&lt;b&gt;Set adaptation modifier m and component signal t&lt;/b&gt;&lt;br&gt;m = calm +0.04; frailty −0.05; age ≥65 −0.05&lt;br&gt;New patient −0.05; returning +0.025; unknown 0&lt;br&gt;t = 1.5q + m − (2 if precise; otherwise 0)&lt;br&gt;Sphere pull = clamp((t + 1) / 4)&lt;br&gt;Cylinder pull = clamp((t + 1) / 2.6); axis pull = clamp(t / 3)" ruleIds="W7_WEIGHTED_COMPONENTS" style="rounded=0;fillColor=#e3f0fc;strokeColor=#47749c;strokeWidth=2.5;whiteSpace=wrap;html=1;fontSize=18;fontFamily=Arial;fontColor=#172635;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1250" y="2660" width="1100" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="TARGETS" value="&lt;b&gt;Form component targets and bounded 0.25 D movements&lt;/b&gt;&lt;br&gt;Sphere target = round(S − sign(S) × min(|S|, 0.25 D)); S is measured&lt;br&gt;C target: same C if corroborated; otherwise reduce |C| by 0.25 D&lt;br&gt;Round targets to 0.25 D; target axis 5° below 1.75 D C, 1° otherwise&lt;br&gt;Movement = round(|target − current| × pull); never overshoot&lt;br&gt;Minimum 0.25 D when gap ≥0.25 D and pull ≥0.2 (S) / 0.25 (C)&lt;br&gt;Base S step cap: precise 0.25 D, otherwise 0.50 D; C cap 0.75 D" ruleIds="W7_WEIGHTED_COMPONENTS" style="rounded=0;fillColor=#e3f0fc;strokeColor=#47749c;strokeWidth=2.5;whiteSpace=wrap;html=1;fontSize=18;fontFamily=Arial;fontColor=#172635;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1200" y="2940" width="1200" height="225" as="geometry"/>
        </mxCell>
        <mxCell id="CURRENT_CYL" value="&lt;b&gt;Current cylinder entered&lt;/b&gt;&lt;br&gt;(including explicit zero)?" ruleIds="W7_WEIGHTED_COMPONENTS" style="rhombus;fillColor=#fff1c9;strokeColor=#9c7a29;strokeWidth=2.5;whiteSpace=wrap;html=1;fontSize=18;fontFamily=Arial;fontColor=#172635;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1570" y="3235" width="460" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="INTRODUCE_BASE_CYL" value="&lt;b&gt;Move from 0 towards the cylinder target&lt;/b&gt;&lt;br&gt;Missing target or output |C| &amp;lt;0.25 D → C/axis blank&lt;br&gt;Otherwise use the target axis" ruleIds="W7_WEIGHTED_COMPONENTS" style="rounded=0;fillColor=#e3f0fc;strokeColor=#47749c;strokeWidth=2.5;whiteSpace=wrap;html=1;fontSize=18;fontFamily=Arial;fontColor=#172635;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="2350" y="3247.5" width="960" height="135" as="geometry"/>
        </mxCell>
        <mxCell id="TOKEN_CYL" value="&lt;b&gt;Measured C explicitly 0&lt;/b&gt;&lt;br&gt;and current |C| ≤0.25 D?" ruleIds="W7_WEIGHTED_COMPONENTS" style="rhombus;fillColor=#fff1c9;strokeColor=#9c7a29;strokeWidth=2.5;whiteSpace=wrap;html=1;fontSize=18;fontFamily=Arial;fontColor=#172635;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1570" y="3465" width="460" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="DROP_TOKEN" value="&lt;b&gt;Remove the token current cylinder and axis&lt;/b&gt;&lt;br&gt;Sphere pull is at least 0.2 for this component step&lt;br&gt;Later sphere overrides still apply" ruleIds="W7_WEIGHTED_COMPONENTS" style="rounded=0;fillColor=#e3f0fc;strokeColor=#47749c;strokeWidth=2.5;whiteSpace=wrap;html=1;fontSize=18;fontFamily=Arial;fontColor=#172635;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="2350" y="3487.5" width="880" height="135" as="geometry"/>
        </mxCell>
        <mxCell id="CYLINDER_MOVE" value="&lt;b&gt;Apply bounded cylinder step&lt;/b&gt;&lt;br&gt;Use target, pull and cap above&lt;br&gt;Missing target → keep current C, rounded to 0.25 D&lt;br&gt;Check cylinder/axis exceptions below" ruleIds="W7_WEIGHTED_COMPONENTS" style="rounded=0;fillColor=#e3f0fc;strokeColor=#47749c;strokeWidth=2.5;whiteSpace=wrap;html=1;fontSize=18;fontFamily=Arial;fontColor=#172635;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1290" y="3715" width="1020" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="CORROBORATED_KEEP" value="&lt;b&gt;Precise, same current/measured C,&lt;/b&gt;&lt;br&gt;ΔS ≤0.25 D and Δaxis &amp;lt;8°?" ruleIds="W7_WEIGHTED_COMPONENTS" style="rhombus;fillColor=#fff1c9;strokeColor=#9c7a29;strokeWidth=2.5;whiteSpace=wrap;html=1;fontSize=18;fontFamily=Arial;fontColor=#172635;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1490" y="3935" width="620" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="KEEP_CORROBORATED" value="&lt;b&gt;Keep current C; below 0.25 D leave C/axis blank&lt;/b&gt;&lt;br&gt;Otherwise keep identical axis exactly or round current axis&lt;br&gt;Axis rounding: 5° below 1.75 D cylinder, 1° otherwise" ruleIds="W7_WEIGHTED_COMPONENTS" style="rounded=0;fillColor=#e3f0fc;strokeColor=#47749c;strokeWidth=2.5;whiteSpace=wrap;html=1;fontSize=18;fontFamily=Arial;fontColor=#172635;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="2350" y="3962.5" width="900" height="145" as="geometry"/>
        </mxCell>
        <mxCell id="CORROBORATED_BLEND" value="&lt;b&gt;Precise, same current/measured C,&lt;/b&gt;&lt;br&gt;ΔS ≤0.25 D and Δaxis 8–20°?" ruleIds="W7_WEIGHTED_COMPONENTS" style="rhombus;fillColor=#fff1c9;strokeColor=#9c7a29;strokeWidth=2.5;whiteSpace=wrap;html=1;fontSize=18;fontFamily=Arial;fontColor=#172635;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1490" y="4205" width="620" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="BLEND_CORROBORATED" value="&lt;b&gt;Keep C except 0.75–&amp;lt;1 D: reduce by 0.25 D&lt;/b&gt;&lt;br&gt;Output |C| &amp;lt;0.25 D → leave C/axis blank&lt;br&gt;Off seam, output |C| ≤0.50 D and gap ≥10°: keep current axis exactly&lt;br&gt;Otherwise midpoint axis; across 0/180 seam use measured axis&lt;br&gt;Round only that changed axis: 5° below 1.75 D, 1° otherwise" ruleIds="W7_WEIGHTED_COMPONENTS" style="rounded=0;fillColor=#e3f0fc;strokeColor=#47749c;strokeWidth=2.5;whiteSpace=wrap;html=1;fontSize=18;fontFamily=Arial;fontColor=#172635;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="2350" y="4212.5" width="1180" height="185" as="geometry"/>
        </mxCell>
        <mxCell id="SMALL_OUTPUT_C" value="&lt;b&gt;Output |C| &amp;lt;0.25 D?&lt;/b&gt;" ruleIds="W7_WEIGHTED_COMPONENTS" style="rhombus;fillColor=#fff1c9;strokeColor=#9c7a29;strokeWidth=2.5;whiteSpace=wrap;html=1;fontSize=18;fontFamily=Arial;fontColor=#172635;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1570" y="4475" width="460" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="DROP_SMALL" value="&lt;b&gt;Leave output cylinder and axis blank&lt;/b&gt;" ruleIds="W7_WEIGHTED_COMPONENTS" style="rounded=0;fillColor=#e3f0fc;strokeColor=#47749c;strokeWidth=2.5;whiteSpace=wrap;html=1;fontSize=18;fontFamily=Arial;fontColor=#172635;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="2350" y="4507.5" width="880" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="MISSING_AXIS" value="&lt;b&gt;Current or target&lt;/b&gt;&lt;br&gt;axis unavailable?" ruleIds="W7_WEIGHTED_COMPONENTS" style="rhombus;fillColor=#fff1c9;strokeColor=#9c7a29;strokeWidth=2.5;whiteSpace=wrap;html=1;fontSize=18;fontFamily=Arial;fontColor=#172635;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1570" y="4705" width="460" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="AVAILABLE_AXIS" value="&lt;b&gt;Use the available axis&lt;/b&gt;&lt;br&gt;No current axis → target; no target axis → current" ruleIds="W7_WEIGHTED_COMPONENTS" style="rounded=0;fillColor=#e3f0fc;strokeColor=#47749c;strokeWidth=2.5;whiteSpace=wrap;html=1;fontSize=18;fontFamily=Arial;fontColor=#172635;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="2350" y="4730" width="880" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="CYL_PROGRESS" value="&lt;b&gt;Calculate cylinder progress&lt;/b&gt;&lt;br&gt;Progress = |output C − current C| / |target C − current C|&lt;br&gt;Clamp to 0–1; no target change → 0&lt;br&gt;Use the shortest axis route&lt;br&gt;“Across seam”: one axis 0–15°, the other 165–180°" ruleIds="W7_WEIGHTED_COMPONENTS" style="rounded=0;fillColor=#e3f0fc;strokeColor=#47749c;strokeWidth=2.5;whiteSpace=wrap;html=1;fontSize=18;fontFamily=Arial;fontColor=#172635;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1240" y="4935" width="1120" height="175" as="geometry"/>
        </mxCell>
        <mxCell id="LOW_CYL_AXIS" value="&lt;b&gt;Off seam, |output C| ≤0.50 D,&lt;/b&gt;&lt;br&gt;axis gap ≥10° and progress &amp;lt;0.5?" ruleIds="W7_WEIGHTED_COMPONENTS" style="rhombus;fillColor=#fff1c9;strokeColor=#9c7a29;strokeWidth=2.5;whiteSpace=wrap;html=1;fontSize=18;fontFamily=Arial;fontColor=#172635;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1490" y="5180" width="620" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="HOLD_LOW_AXIS" value="&lt;b&gt;Keep the current axis&lt;/b&gt;" ruleIds="W7_WEIGHTED_COMPONENTS" style="rounded=0;fillColor=#e3f0fc;strokeColor=#47749c;strokeWidth=2.5;whiteSpace=wrap;html=1;fontSize=18;fontFamily=Arial;fontColor=#172635;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
