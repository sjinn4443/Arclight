{
  "name": "vscode-alanui-launcher",
  "publisher": "your-publisher-name",
  "displayName": "Arclight App Launcher",
  "description": "Starts Arclight App when needed and opens localhost:3000 in Google Chrome from the status bar.",
  "version": "0.0.8",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/vscode-alanui-launcher.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "vscode-alanui-launcher.launchArclightApp",
        "title": "Arclight: Launch App on Local 3000"
      },
      {
        "command": "vscode-alanui-launcher.openLocalhost3000",
        "title": "Arclight: Open localhost:3000"
      }
    ]
  },
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "prepublishOnly": "npm run compile",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.0.0",
    "vsce": "^2.15.0",
    "vscode": "^1.1.37"
  },
  "dependencies": {
    "vscode-extension-tester": "^1.0.0"
  }
}
