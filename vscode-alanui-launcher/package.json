{
  "name": "vscode-alanui-launcher",
  "displayName": "Arclight App Launcher",
  "description": "Launches Arclight App on localhost:3000 with a status bar button.",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/vscode-alanui-launcher.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:vscode-alanui-launcher.launchArclightApp"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "prepublishOnly": "npm run compile",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "typescript": "^5.0.0",
    "vsce": "^2.15.0",
    "vscode": "^1.1.37"
  },
  "dependencies": {
    "vscode-extension-tester": "^1.0.0"
  }
}
