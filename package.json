{
  "name": "arclight-app",
  "version": "1.0.0",
  "main": "public/sw.js",
  "type": "module",
  "scripts": {
    "prepare": "husky install",
    "test": "cross-env NODE_ENV=test NODE_OPTIONS=--expose-gc node_modules/jest/bin/jest.js --config jest.config.cjs",
    "dev": "cross-env NODE_ENV=development PORT=3000 nodemon server.cjs",
    "start": "node server.cjs",
    "start:prod": "NODE_ENV=production node server.cjs",
    "serve:prod": "npm run build && cross-env NODE_ENV=production node server.cjs",
    "start:track": "cross-env PORT=3001 node server.cjs",
    "test:ci": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules node -r dotenv/config node_modules/jest/bin/jest.js --verbose --config jest.config.cjs",
    "build": "node scripts/build.cjs",
    "check-translations": "node scripts/check-translations.cjs",
    "test:a11y": "node scripts/test-a11y.mjs",
    "test:e2e": "playwright test",
    "perf:lh": "lhci autorun",
    "perf:e2e": "playwright test tests-e2e/perf",
    "lint": "eslint . --ext .js,.ts",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,cjs,css,html,json,md}": "prettier --write"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "connect-redis": "^9.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csurf": "^1.11.0",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "geoip-lite": "^1.4.10",
    "helmet": "^8.1.0",
    "http-server": "^14.1.1",
    "morgan": "^1.10.1",
    "node-fetch": "^2.7.0",
    "pg": "^8.16.3",
    "redis": "^5.9.0",
    "sharp": "^0.34.3"
  },
  "devDependencies": {
    "@babel/core": "^7.24.7",
    "@babel/preset-env": "^7.24.7",
    "@eslint/js": "^9.38.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "babel-jest": "^29.7.0",
    "clean-css-cli": "^5.6.3",
    "cross-env": "^10.1.0",
    "esbuild": "^0.25.10",
    "eslint": "^9.36.0",
    "fs-extra": "^11.3.2",
    "globals": "^16.4.0",
    "globby": "^11.1.0",
    "html-minifier-terser": "^7.2.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.0.0",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.2.4",
    "mkdirp": "^3.0.1",
    "mocha": "^10.0.0",
    "next": "^15.5.6",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "prisma": "^6.17.1",
    "react": "^19.2.0",
    "service-worker-mock": "^2.0.5",
    "supertest": "^7.1.4",
    "terser": "^5.44.0",
    "typescript": "^5.9.3"
  }
}
